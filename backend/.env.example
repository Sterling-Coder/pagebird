# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Frontend origin(s) allowed to call this API (comma-separated for staging+prod).
FRONTEND_ORIGIN=http://localhost:3000

# Supabase — verifies the bearer token /api/* requests carry (via
# /auth/v1/user, no JWT secret needed) and checks trial status against the
# profiles table (service role key, bypasses RLS). See docs/supabase/schema.sql.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM primary engine (recommended for accuracy). Leave all blank to run identity/passthrough.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force a provider (openai|anthropic); leave blank to auto-pick (OpenAI preferred).
BABEL_LLM_PROVIDER=openai
# Model for the selected provider. gpt-5.2 = latest/best accuracy; gpt-4.1 = cheaper, 1M context.
BABEL_LLM_MODEL=gpt-5.2

# Second-pass LLM verification of every translation (accuracy floor). 1=on (default), 0=off.
BABEL_VERIFY=1

# DeepL secondary engine (consensus / disagreement flags). Optional.
DEEPL_AUTH_KEY=

# InDesign Server SOAP endpoint or app path for IDML->PDF/INDD export (Phase 3).
# Leave blank to emit the ExtendScript for a manual InDesign run instead.
INDESIGN_SERVER=

# OCR (scanned pages + text baked into raster images/diagrams). Optional — the
# pipeline runs offline without it (local rapidocr fallback if installed, else
# skipped). Priority: docai > vision > http service > rapidocr > none.
# Document AI (best layout accuracy on full-page scans) and Vision (best on
# stylized/decorative graphic text, e.g. banners/callouts) share the same GCP
# service-account credentials.
GOOGLE_APPLICATION_CREDENTIALS=
DOCAI_PROJECT_ID=
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
# Force one engine (docai|vision|http|rapidocr|none). Leave blank to auto-pick.
BABEL_OCR_ENGINE=
# External OCR microservice (see babel/ingest/ocr.py:ocr_http_url docstring).
OCR_API_BASE_URL=
